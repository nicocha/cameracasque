{
  "expo": {
    "name": "Caméra Casque",
    "slug": "cambox",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nicocha.cameracasque",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "Connexion à votre caméra Cambox V3+ sur son réseau WiFi.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "9HHH9VUQRW"
    },
    "android": {
      "package": "com.nicocha.cameracasque",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "minSdkVersion": 26
          }
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": "Enregistrer les photos et vidéos de la caméra dans votre galerie.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": []
        }
      ],
      "react-native-vlc-media-player",
      "expo-router",
      "expo-sharing"
    ],
    "scheme": "cambox",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "f988764a-7079-4c1a-adb9-44d16a8617c9"
      }
    },
    "owner": "nicocha"
  }
}
